                  "PackageType": 1,
                  "ItemName": "banner.png"
                }
              }
            }
          }
        }
      ],
      "imageScaling": [
        {
          "properties": {
            "imageScalingType": {
              "expr": {
                "Literal": {
                  "Value": "'Fill'"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ],
      "background": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            },
            "color": {
              "solid": {
