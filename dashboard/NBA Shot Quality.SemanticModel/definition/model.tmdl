model 'NBA Shot Quality'
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_ProTooling = ["MCP-PBIModeling"]

ref table Player
ref table Season
ref table 'Player Season'
ref table 'Curry Shot'
ref table 'Min Shots'
ref table Metrics

